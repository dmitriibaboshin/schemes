<mxfile host="app.diagrams.net" type="device">
  <diagram id="hermes-isolation" name="Hermes isolation topology">
    <mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1410" pageHeight="1830" background="#EDF0F3" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c125" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=#E4E8ED;strokeColor=#BCC5D0;strokeWidth=1;" vertex="1" parent="1">
