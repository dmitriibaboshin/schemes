          <mxCell style="html=1;whiteSpace=wrap;strokeColor=#BCC5D0;fillColor=none;spacing=2;fontSize=11.5;fontColor=#4B57C9;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;" vertex="1" parent="1">
