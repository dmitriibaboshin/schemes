          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="vLLM принимает трафик только от подов vLLM router. Router обращается только к подам vLLM, а если находит их по меткам, то ещё к API-серверу." id="c62">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="731" y="495" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="vLLM обращается только к S3 с моделями. Ключ — только на чтение и только к бакету моделей. Веса загружаются при старте." id="c63">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="976" y="495" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="iron-proxy · llm принимает трафик только от подов Agent Router." id="c64">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="743" y="621" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="iron-proxy выходит в интернет только по TCP 443. Запрещены RFC1918, адрес метаданных, loopback, диапазоны подов и сервисов и внутренние сети." id="c65">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="971" y="621" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="iron-proxy · gateway принимает трафик только от Hermes. Hermes обращается только к Agent Router, ContextForge, песочнице по TCP 2222 (фаза 1), sandbox-router и API-серверу для SandboxClaim (фаза 2), iron-proxy · gateway и DNS кластера." id="c66">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="746" y="227" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="iron-proxy выходит в интернет только по TCP 443. Запрещены RFC1918, адрес метаданных, loopback, диапазоны подов и сервисов и внутренние сети." id="c67">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="971" y="227" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="Agent Router (Envoy AI Gateway) принимает трафик только от Hermes, а после перехода — и от других клиентов моделей, у каждого свой ключ." id="c68">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="222" y="495" width="28" height="18" as="geometry" />
