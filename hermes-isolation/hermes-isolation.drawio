          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#C4E4DA;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
