        <UserObject label="≥0.16.0" tooltip="Hermes Agent 0.16.0 или новее: закрыты CVE-2026-53869 (DNS rebinding в веб-интерфейсе) и CVE-2026-53870 (база данных доступна на чтение всем). Последняя версия: 0.19.0." id="c61">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
