          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="sandbox-router (фаза 2) принимает трафик только от Hermes, по TCP 8080." id="c76">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="222" y="893" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="Песочница (фаза 2) принимает трафик только от подов sandbox-router, по TCP 8080/9090. sandbox-router обращается только к подам песочниц и API-серверу." id="c77">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="476" y="893" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="Песочница (фаза 1) принимает трафик только от Hermes, по TCP 2222; sshd работает не от root." id="c78">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="476" y="951" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="Песочница обращается только к iron-proxy · sandbox: DNS 53 и порт туннеля. DNS кластера ей недоступен. iron-proxy · sandbox принимает трафик только от подов песочниц." id="c79">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="743" y="893" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="iron-proxy выходит в интернет только по TCP 443, плюс одно явное исключение для GitLab, если он во внутренней сети. Остальные частные диапазоны запрещены." id="c80">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="961" y="893" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="✕" tooltip="Прямой выход песочницы в интернет запрещён в Calico, в tier security, который проверяется раньше любых Kubernetes NetworkPolicy." id="c81">
          <mxCell style="shape=ellipse;perimeter=ellipsePerimeter;html=1;fillColor=#EDF0F3;strokeColor=#C3303B;strokeWidth=1.4;fontColor=#C3303B;fontSize=13;fontStyle=1;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="997" y="965" width="18" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждое срабатывание: правило, клиент, модель и действие — замаскировал, заблокировал или пропустил с алертом. Промпты целиком в лог не пишутся, только замаскированный фрагмент совпадения." id="c82">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="306" y="576.5" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый запрос: модель, выбранный экземпляр vLLM, код ответа и время, плюс метрики нагрузки по экземплярам. Кто клиент, router не знает: это видно в Agent Router." id="c83">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="526" y="524.5" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Состояние сервера и ошибки. Запросы смотрят в Agent Router; журнал запросов vLLM держат выключенным, иначе в логах окажутся все промпты." id="c84">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="896" y="464" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Состояние сервера и ошибки. Запросы смотрят в Agent Router; журнал запросов vLLM держат выключенным, иначе в логах окажутся все промпты." id="c85">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="896" y="518" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый запрос Agent Router к провайдеру: метод, хост, путь, пропущен или отклонён. Тела не пишутся: в них промпты и ответы модели." id="c86">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="600" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Единственная запись текста каждой команды, и в фазе 1, и в фазе 2. Ещё в логе вызовы инструментов, ответы модели и подтверждения. Его пишет тот же под, который решает, что запускать, поэтому это не независимая запись." id="c87">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="147" y="192" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Envoy access log на каждый вызов модели: время, длительность, путь, код ответа, запрошенная и фактическая модель, бэкенд, токены на входе и выходе, IP пода, x-request-id. Имя клиента появится, если включить forwardClientIDHeader и добавить этот заголовок в формат лога. Промптов, ответов и выбранных моделью вызовов инструментов в access log нет: всё это в телах. Трейсы OpenTelemetry по умолчанию (OpenInference) хранят тела целиком; скрываются через OPENINFERENCE_HIDE_INPUTS и _OUTPUTS." id="c88">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="276" y="470" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый вызов MCP-инструмента: какой инструмент, кто вызвал, результат, срабатывания плагинов. Эта запись не зависит от Hermes." id="c89">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="331" y="736.5" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Собственные логи серверов: у каждого свой состав, и пишутся они внутри пода, который разбирает недоверенный контент. Записи, которые MCP-сервер не может подделать, — в ContextForge (вызовы) и iron-proxy · mcp (запросы наружу)." id="c90">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="668" y="678" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый запрос Hermes к Telegram: метод, путь, пропущен или отклонён. Тела не пишутся, текстов сообщений в логе нет." id="c91">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="206" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый запрос MCP-серверов к внешним API: метод, хост, путь, пропущен или отклонён. Тела не пишутся." id="c92">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="692" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Каждый запрос песочницы наружу: метод, хост, путь, пропущен или отклонён. Видны сетевые последствия команд (pip install, git push, поиск, попытки выйти к чужим хостам), но не сами команды. Тела не пишутся." id="c93">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="872" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Фаза 2: каждый вызов sandboxd — кто вызвал, какая песочница, метод и путь. Запись вне Hermes и песочницы. Текст команды появится здесь, только если логировать тело запроса с маскированием секретов." id="c94">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="276" y="872" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="gVisor может отдавать событие на каждый запуск процесса в песочнице (runtime monitoring), включая процессы, которые запускают скрипты. Сопровождаемого потребителя этих событий сейчас нет. Stdout пода пишется изнутри песочницы, и агент может его подделать." id="c95">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="662" y="834" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Фаза 2: собственный лог sandboxd пишется внутри песочницы под тем же UID, что и команды агента, поэтому агент может его подделать. Запись, которую агент подделать не может, — в sandbox-router." id="c96">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="636" y="914.5" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Hermes запускает каждую команду отдельным exec (ssh … bash -c) по общему соединению ControlMaster. Штатный sshd на LogLevel VERBOSE пишет вход по ключу один раз на соединение и строку «Starting session: command» на каждую команду, без её текста. Текст команды можно записать только обёрткой ForceCommand: sshd передаёт его ей в $SSH_ORIGINAL_COMMAND. Лог пишется внутри песочницы под тем же UID, что и команды агента, поэтому агент может его подделать. Соединения Hermes → sshd независимо видны во flow logs Calico." id="c97">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="636" y="972.5" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="logging" tooltip="Создание и удаление песочниц, тёплый пул, ошибки шаблонов. Кто создал или удалил SandboxClaim, видно только в аудите Kubernetes API, а его ещё нужно включить." id="c98">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="386" y="1002" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="c102" value="userns" style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#56638A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="904" y="112" width="48" height="15" as="geometry" />
        </mxCell>
        <UserObject label="logging" tooltip="Лог доступа: кто открыл веб-интерфейс, когда и какие пути запрашивал. Это журнал входов в панель, которая может менять конфигурацию Hermes." id="c103">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=15;whiteSpace=nowrap;html=1;fillColor=#8A3F7A;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="112" width="58" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="NP" tooltip="Hermes принимает трафик только от ingress-шлюза и только на порт веб-интерфейса. Самому ingress нужны TLS, аутентификация и доступ только из LAN или VPN." id="c104">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="246" y="137" width="28" height="18" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="≥1.9.2" tooltip="Envoy Gateway 1.9.2 или новее (Envoy 1.39.1): закрыты августовские уязвимости Envoy 2026 года, в том числе fail-open в regex RBAC и обходы через нормализацию пути. Поддержка до 14.02.2027." id="c105">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="796" y="166.5" width="52" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="k8s ≥1.33" tooltip="Envoy Gateway 1.9 поддерживает Kubernetes 1.33–1.36." id="c106">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="854" y="166.5" width="72" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="k8s ≥1.36.5" tooltip="Kubernetes — основа схемы: RuntimeClass выбирает рантайм пода, admission-политики и NetworkPolicy задают границы. Версия 1.36.5 или новее: CVE-2026-2270 (с правом на запись StatefulSet можно создать под в другом namespace). Дизайн рассчитан на возможности 1.36." id="c107">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="160" y="1083.5" width="85" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Calico ≥3.32.1" tooltip="Calico — CNI и движок сетевых политик: default-deny и tier security, который обычные NetworkPolicy не могут ослабить. Версия 3.32.1 или новее: TTA-2026-004/005/006, включая обход авторизации для tiers. 3.32 — первый релиз, проверенный на Kubernetes 1.36 (тестируется на 1.34–1.36)." id="c108">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="253" y="1083.5" width="105" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="containerd ≥2.3.6" tooltip="containerd — рантайм контейнеров на узлах: по RuntimeClass запускает поды через runc, runsc или NVIDIA runtime. Версия 2.3.6 или новее: CVE-2026-53488 (label образа даёт root на хосте при pull), исправления checkpoint и DoS; этой версии хватает и для user namespaces с runsc." id="c109">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=nowrap;html=1;fillColor=#18212C;strokeColor=none;fontColor=#EDF0F3;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
            <mxGeometry x="366" y="1083.5" width="125" height="15" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="runc ≥1.4.3" tooltip="runc — стандартный OCI-рантайм для платформенных подов и vLLM; их изолируют namespaces, seccomp и user namespaces. Версия 1.4.3 или 1.5.x: CVE-2026-41579." id="c110">
