          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=18;html=1;fillColor=#E6E8FA;strokeColor=#4B57C9;strokeWidth=1.2;fontColor=#4B57C9;fontSize=11;fontFamily=JetBrains Mono;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DJetBrains%2BMono;spacing=0;" vertex="1" parent="1">
