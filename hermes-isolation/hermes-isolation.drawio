          <mxGeometry x="776" y="432" width="198" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c129" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E8A75;strokeWidth=1.3;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="49" y="199" width="164" height="800" as="geometry" />
        </mxCell>
        <mxCell id="c130" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E8A75;strokeWidth=1.3;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="512" y="686" width="222" height="66" as="geometry" />
        </mxCell>
        <mxCell id="c131" value="" style="rounded=1;absoluteArcSize=1;arcSize=28;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E8A75;strokeWidth=1.3;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="512" y="842" width="216" height="162" as="geometry" />
        </mxCell>
        <mxCell id="c132" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E8A75;strokeWidth=1.3;dashed=1;dashPattern=8 4;" vertex="1" parent="1">
          <mxGeometry x="24" y="1131" width="18" height="18" as="geometry" />
        </mxCell>
        <mxCell id="c203" value="" style="rounded=1;absoluteArcSize=1;arcSize=24;html=1;fillColor=#E4E8ED;strokeColor=#BCC5D0;" vertex="1" parent="1">
          <mxGeometry x="20" y="1266" width="1350" height="524" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Sandbox pod&lt;/div&gt;" tooltip="Под песочницы — здесь выполняются команды агента. Работает под gVisor, секретов не содержит, наружу выходит только через iron-proxy · sandbox. В фазе 1 одна долгоживущая песочница, состояние сбрасывают пересозданием; в фазе 2 — своя на каждую задачу." id="c133">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DCEEE8;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;verticalAlign=top;spacingTop=9;" vertex="1" parent="1">
            <mxGeometry x="520" y="850" width="200" height="146" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Agent service&lt;/div&gt;" tooltip="Сервис агентов: запускает агентов и вызывает модели. Сейчас — к vLLM router через Legacy ingress. Дальше — через Agent Router со своим ключом и лимитом токенов." id="c134">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="264" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Agent platform&lt;/div&gt;" tooltip="Вторая агентская платформа со своими инструментами и памятью. Сейчас — к vLLM router через Legacy ingress. Дальше — через Agent Router со своим ключом и лимитом токенов." id="c135">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="366" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Memory service&lt;/div&gt;" tooltip="Сервис памяти агентов: моделью извлекает факты из диалогов и хранит их. Сейчас — к vLLM router через Legacy ingress. Дальше — через Agent Router со своим ключом и лимитом токенов." id="c136">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="468" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Filter proxy&lt;/div&gt;" tooltip="Фильтр-прокси между агентами и моделью: проверяет промпты и ответы, но только у тех, кто ходит через него. Сейчас пересылает запросы к vLLM router через Legacy ingress. Дальше его заменяет Guardrails внутри Agent Router, который обойти нельзя." id="c137">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="570" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;SRE agent&lt;/div&gt;" tooltip="SRE-ассистент: разбирает алерты и инциденты с помощью модели. Сейчас — к vLLM router напрямую по адресу сервиса, мимо ingress. Дальше — через Agent Router со своим ключом и лимитом токенов." id="c138">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="672" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;LLM proxy&lt;/div&gt;" tooltip="LLM-прокси со своими ключами и учётом расходов. Сейчас пересылает запросы к vLLM router через Legacy ingress. Дальше — либо за Agent Router, либо убрать: ключи и лимиты есть в самом Agent Router." id="c139">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="774" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;API gateway&lt;/div&gt;" tooltip="API-шлюз с ключами и лимитами для внешних клиентов. Один маршрут ведёт к vLLM router через Legacy ingress, три — прямо к экземплярам vLLM, мимо router. Дальше — либо остаётся внешним входом перед Agent Router, либо его убирают; прямые маршруты к vLLM закрываются." id="c140">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="876" y="306" width="94" height="28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#8C7A6B;line-height:1.15&quot;&gt;Legacy ingress&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:500;color:#5A6676;line-height:1.15&quot;&gt;ingress-nginx&lt;/div&gt;" tooltip="Legacy ingress на ingress-nginx: через него клиенты сейчас ходят к vLLM router. Запрос выходит из сети подов и возвращается через ingress, местами по HTTP и без проверки TLS. Проект ingress-nginx закрыт в марте 2026 года, исправлений безопасности больше нет. Модельный трафик переходит на Agent Router, остальной — на Envoy Gateway; после перехода NetworkPolicy vLLM router пускает только Agent Router." id="c141">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#8C7A6B;strokeWidth=1.3;dashed=1;dashPattern=9 3 2 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="520" y="370" width="110" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Guardrails&lt;/div&gt;" tooltip="Guardrails — фильтр содержимого внутри Agent Router, а не отдельный сервис, поэтому его нельзя обойти. Видит всё, что попадает в модель, в том числе вывод команд, результаты поиска и сообщения Telegram, которые не проходят через ContextForge. Публичные LLM: маскирует секреты и персональные данные и блокирует запрос, если совпадение осталось. Своя модель: ищет prompt injection и секреты только в режиме алертов — это сигнал, а не барьер. Цена — задержка на каждом вызове и ложные срабатывания. Пока это план: продукт не выбран, совместимость с собственным фильтром Agent Router нужно проверить." id="c142">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=32;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#1F7FA8;strokeWidth=1.3;dashed=1;dashPattern=6 4;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="300" y="552" width="118" height="32" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:15px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Hermes&lt;/div&gt;&lt;div style=&quot;font-size:15px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Gateway/Harness&lt;/div&gt;" tooltip="Hermes Gateway/Harness — сам агент: ведёт диалог, вызывает модель и инструменты и решает, какие команды запускать. У него ключ Agent Router, токен ContextForge и SSH-ключ к песочнице, поэтому команды он выполняет не у себя, а в песочнице." id="c143">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DCEEE8;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="56" y="206" width="150" height="786" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;iron-proxy · gateway&lt;/div&gt;" tooltip="iron-proxy · gateway — выход Hermes в интернет, только к api.telegram.org. Подставляет настоящий токен бота, у Hermes остаётся заглушка." id="c144">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="214" width="170" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Telegram API&lt;/div&gt;" tooltip="Telegram Bot API — второй канал общения с агентом. Hermes сам опрашивает его (long polling), входящих соединений нет." id="c145">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="218" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;iron-proxy · llm&lt;/div&gt;" tooltip="iron-proxy · llm — выход Agent Router к публичным LLM API: только хосты провайдеров и POST на их эндпоинты генерации, например /v1/messages у Anthropic. Ключ провайдера подставляет прокси, в Agent Router только заглушка." id="c146">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="608" width="170" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Public LLM&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:500;color:#5A6676;line-height:1.15&quot;&gt;Claude · Qwen · …&lt;/div&gt;" tooltip="Публичные LLM API (Anthropic Claude, Qwen в Alibaba Cloud и другие) — альтернатива своей модели. Промпты, файлы и вывод инструментов уходят провайдеру, поэтому нужен список задач и данных, которые можно отправлять наружу; на этом маршруте Guardrails маскирует секреты и персональные данные." id="c147">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="606" width="150" height="48" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Agent Router&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:500;color:#5A6676;line-height:1.15&quot;&gt;Envoy AI Gateway&lt;/div&gt;" tooltip="Agent Router (Envoy AI Gateway) — единственный путь к моделям: своим, через vLLM router, и публичным API. Выбирает бэкенд по имени модели, у каждого клиента свой ключ и лимит токенов. Пропускает только /v1/chat/completions и /v1/models; для Claude напрямую ещё /v1/messages, потому что бэкенд Anthropic принимает только родной Messages API. Так закрыты эндпоинты vLLM, которые его API-ключ не защищает: /metrics, /tokenize и другие." id="c148">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="270" y="478" width="180" height="54" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;vLLM router&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:500;color:#5A6676;line-height:1.15&quot;&gt;Production Stack&lt;/div&gt;" tooltip="vLLM router (vLLM Production Stack) — балансировщик между экземплярами vLLM: по имени модели выбирает экземпляры с этой моделью и распределяет между ними нагрузку (round-robin, привязка к сессии или по KV-кэшу). Клиентов не проверяет и лимитов не ставит, поэтому в целевой схеме стоит за Agent Router и клиентам недоступен; прямые пути других клиентов к нему — наследие." id="c149">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="520" y="478" width="200" height="54" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;vLLM · Qwen&lt;/div&gt;" tooltip="vLLM — сервер инференса модели Qwen на GPU. Работает на runc с NVIDIA runtime, без gVisor, поэтому от остального кластера его отделяют NetworkPolicy (трафик только от vLLM router), отдельный узел с taint и запуск не от root; user namespace для него ещё проверяется." id="c150">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F4E3C6;strokeColor=#B07421;strokeWidth=1.2;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="472" width="170" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;vLLM · gpt-oss-20b&lt;/div&gt;" tooltip="Второй экземпляр vLLM с другой моделью, для примера gpt-oss-20b. vLLM router отправляет сюда запросы, в которых указана эта модель. Если обе модели на одной GPU без MIG, они делят её память без изоляции." id="c151">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F4E3C6;strokeColor=#B07421;strokeWidth=1.2;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="526" width="170" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;S3 · models&lt;/div&gt;" tooltip="S3 — хранилище весов моделей. vLLM скачивает их при старте ключом только на чтение." id="c152">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="486" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;ContextForge&lt;/div&gt;" tooltip="ContextForge — шлюз MCP, единая точка доступа к инструментам. Hermes видит только инструменты своего виртуального сервера, вызовы проходят через плагины проверки (например, PII Filter, Secrets Detection и deny-фильтры), учётные данные инструментов хранятся здесь, а не в Hermes." id="c153">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="270" y="700" width="180" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" tooltip="MCP-серверы — инструменты агента (GitLab, Keep, инструменты кластера и другие), каждый в своём поде под gVisor. Доступны только через ContextForge." id="c154">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DCEEE8;strokeColor=#2E8A75;strokeWidth=1;" vertex="1" parent="1">
            <mxGeometry x="526" y="694" width="200" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="c155" value="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;MCP servers&lt;/div&gt;" style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#DCEEE8;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="520" y="700" width="200" height="44" as="geometry" />
        </mxCell>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;iron-proxy · mcp&lt;/div&gt;" tooltip="iron-proxy · mcp — выход MCP-серверов к их внешним API, только к разрешённым хостам. Токены подставляет, если API принимает токен как есть; запросы с подписью (например, AWS SigV4) так подменить нельзя." id="c156">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="700" width="170" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Tool APIs&lt;/div&gt;" tooltip="API инструментов — внешние сервисы, к которым обращаются MCP-серверы." id="c157">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="704" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;PostgreSQL&lt;/div&gt;" tooltip="PostgreSQL — база ContextForge: серверы, инструменты, токены и зашифрованные учётные данные." id="c158">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="270" y="782" width="85" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:12px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Redis&lt;/div&gt;" tooltip="Redis — кэш и сессии ContextForge." id="c159">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="365" y="782" width="85" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;sandbox-router&lt;/div&gt;" tooltip="sandbox-router — единственный вход к sandboxd в фазе 2: проверяет токен на каждый вызов и пишет аудит. Ставится отдельным Deployment, контроллер его не создаёт." id="c160">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="270" y="880" width="180" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;sandboxd&lt;/div&gt;" tooltip="sandboxd — API внутри песочницы: запуск команд и работа с файлами. Нужен для фазы 2, когда Hermes перейдёт с SSH на плагин." id="c161">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#C4E4DA;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="540" y="882" width="160" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;sshd&lt;/div&gt;" tooltip="sshd — вход Hermes в песочницу по SSH в фазе 1, пока нет плагина sandboxd. Работает не от root, на порту 2222." id="c162">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#C4E4DA;strokeColor=#2E8A75;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="540" y="940" width="160" height="40" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;iron-proxy · sandbox&lt;/div&gt;" tooltip="iron-proxy · sandbox — единственный выход песочницы: пропускает только разрешённые хосты и методы и подставляет токены GitLab и поиска. DNS песочницы тоже на нём: на любое имя он отвечает своим адресом и ничего не пересылает, так что DNS-туннель не работает." id="c163">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="790" y="880" width="170" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;PyPI · npm&lt;/div&gt;" tooltip="PyPI и npm — установка пакетов в песочнице. Через iron-proxy разрешены только GET и HEAD." id="c164">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="840" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;GitLab&lt;/div&gt;" tooltip="GitLab — репозитории, с которыми работает агент. Токен подставляет iron-proxy, в песочнице его нет." id="c165">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="884" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Search API&lt;/div&gt;" tooltip="API поиска — единственный доступ агента к вебу. Ключ подставляет iron-proxy." id="c166">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDF0F3;strokeColor=#7F8C9D;strokeWidth=1;dashed=1;dashPattern=3 3;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="1050" y="928" width="150" height="36" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;agent-sandbox controller&lt;/div&gt;" tooltip="Контроллер agent-sandbox создаёт поды песочниц из SandboxTemplate по объектам Sandbox и SandboxClaim, держит тёплый пул и удаляет песочницы, когда claim удалён или истёк срок." id="c167">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
            <mxGeometry x="270" y="1010" width="180" height="44" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;div style=&quot;font-size:13px;font-weight:600;color:#18212C;line-height:1.15&quot;&gt;Ingress&lt;/div&gt;&lt;div style=&quot;font-size:11.5px;font-weight:500;color:#5A6676;line-height:1.15&quot;&gt;Envoy Gateway&lt;/div&gt;" tooltip="Ingress (Envoy Gateway) — единственный вход пользователя в кластер, пропускает только к веб-интерфейсу Hermes. Здесь же TLS и аутентификация." id="c168">
          <mxCell style="rounded=1;absoluteArcSize=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#96A2B2;strokeWidth=1;fontFamily=Archivo;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchivo;fontColor=#18212C;spacing=2;" vertex="1" parent="1">
